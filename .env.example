# Copy to .env and fill in before `docker compose up`.

# Seeded admin account (created once, on first boot only).
# Leave VAPT_ADMIN_PASSWORD blank to auto-generate a strong random password
# (it will be printed in the container logs and saved to data/INITIAL_CREDENTIALS.txt).
VAPT_ADMIN_USER=admin
VAPT_ADMIN_PASSWORD=

# Optional: free at https://wpscan.com/api -- enables CVE-level results for
# WordPress plugin/theme/core findings instead of just version enumeration.
WPSCAN_API_TOKEN=
